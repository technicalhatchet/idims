{
  "templateId": "refrigerator",
  "categories": [
    { "id": "defrost_system", "label": "Defrost System", "dmaTags": ["defrost", "frost_buildup", "defrost_heater"] },
    { "id": "airflow", "label": "Airflow / Fans", "dmaTags": ["evap_fan", "condenser_fan", "airflow"] },
    { "id": "sealed_system", "label": "Sealed System", "dmaTags": ["compressor", "refrigerant", "sealed_system"] },
    { "id": "door_seal", "label": "Door / Gasket / Alignment", "dmaTags": ["gasket", "door_alignment", "air_leak"] },
    { "id": "electrical_supply", "label": "Electrical Supply", "dmaTags": ["voltage_check", "supply_issue", "no_power"] },
    { "id": "water_dispenser", "label": "Water / Dispenser", "dmaTags": ["water_dispenser", "inlet_valve", "filter"] },
    { "id": "ice_maker", "label": "Ice Maker", "dmaTags": ["ice_maker", "no_ice"] },
    { "id": "control_board", "label": "Controls / Sensors", "dmaTags": ["thermistor", "control_board", "sensor_check"] },
    { "id": "demo_mode", "label": "Cooling Off / Demo", "dmaTags": ["control_board", "demo_mode"] }
  ],
  "hypotheses": [
    { "id": "defrost_heater_ok", "category": "defrost_system", "label": "Defrost heater good", "oppositeId": "defrost_heater_failed" },
    { "id": "defrost_heater_failed", "category": "defrost_system", "label": "Defrost heater failed", "oppositeId": "defrost_heater_ok" },
    { "id": "defrost_thermostat_ok", "category": "defrost_system", "label": "Defrost termination OK", "oppositeId": "defrost_thermostat_failed" },
    { "id": "defrost_thermostat_failed", "category": "defrost_system", "label": "Defrost thermostat / terminator failed", "oppositeId": "defrost_thermostat_ok" },
    { "id": "defrost_fuse_ok", "category": "defrost_system", "label": "Defrost fuse good", "oppositeId": "defrost_fuse_failed" },
    { "id": "defrost_fuse_failed", "category": "defrost_system", "label": "Defrost thermal fuse blown", "oppositeId": "defrost_fuse_ok" },
    { "id": "evap_fan_ok", "category": "airflow", "label": "Evap fan OK", "oppositeId": "evap_fan_failed" },
    { "id": "evap_fan_failed", "category": "airflow", "label": "Evap fan failed", "oppositeId": "evap_fan_ok" },
    { "id": "condenser_fan_ok", "category": "airflow", "label": "Condenser fan OK", "oppositeId": "condenser_fan_failed" },
    { "id": "condenser_fan_failed", "category": "airflow", "label": "Condenser fan failed", "oppositeId": "condenser_fan_ok" },
    { "id": "compressor_ok", "category": "sealed_system", "label": "Compressor running normally", "oppositeId": "compressor_failed" },
    { "id": "compressor_failed", "category": "sealed_system", "label": "Compressor / start issue", "oppositeId": "compressor_ok" },
    { "id": "sealed_system_fault", "category": "sealed_system", "label": "Sealed system restriction/leak" },
    { "id": "inverter_ok", "category": "sealed_system", "label": "Inverter board OK", "oppositeId": "inverter_failed" },
    { "id": "inverter_failed", "category": "sealed_system", "label": "Inverter board fault", "oppositeId": "inverter_ok" },
    { "id": "damper_ok", "category": "airflow", "label": "Damper OK", "oppositeId": "damper_failed" },
    { "id": "damper_failed", "category": "airflow", "label": "Damper motor / heater fault", "oppositeId": "damper_ok" },
    { "id": "door_switch_ok", "category": "door_seal", "label": "Door switch OK", "oppositeId": "door_switch_failed" },
    { "id": "door_switch_failed", "category": "door_seal", "label": "Door reed switch fault", "oppositeId": "door_switch_ok" },
    { "id": "cooling_off_active", "category": "demo_mode", "label": "Cooling Off / demo active", "oppositeId": "cooling_off_cleared" },
    { "id": "cooling_off_cleared", "category": "demo_mode", "label": "Cooling Off ruled out", "oppositeId": "cooling_off_active" },
    { "id": "door_alignment_ok", "category": "door_seal", "label": "Door alignment OK", "oppositeId": "door_alignment_fault" },
    { "id": "door_alignment_fault", "category": "door_seal", "label": "Door alignment fault", "oppositeId": "door_alignment_ok" },
    { "id": "gasket_ok", "category": "door_seal", "label": "Door gasket OK", "oppositeId": "gasket_fault" },
    { "id": "gasket_fault", "category": "door_seal", "label": "Door gasket fault", "oppositeId": "gasket_ok" },
    { "id": "supply_ok", "category": "electrical_supply", "label": "Supply voltage OK", "oppositeId": "supply_fault" },
    { "id": "supply_fault", "category": "electrical_supply", "label": "Supply / voltage issue", "oppositeId": "supply_ok" }
  ],
  "rules": [
    {
      "id": "heater_ol",
      "when": { "type": "measurement", "knowledgeId": "defrostHeaterOhms", "statusIn": ["critical"] },
      "eliminate": ["defrost_heater_ok"],
      "confirm": ["defrost_heater_failed"]
    },
    {
      "id": "heater_normal",
      "when": { "type": "measurement", "knowledgeId": "defrostHeaterOhms", "statusIn": ["normal"] },
      "eliminate": ["defrost_heater_failed"],
      "confirm": ["defrost_heater_ok"]
    },
    {
      "id": "samsung_heater_ol",
      "when": { "type": "measurement", "knowledgeId": "samsungRefrigeratorDefrostHeaterOhms", "statusIn": ["critical"] },
      "eliminate": ["defrost_heater_ok"],
      "confirm": ["defrost_heater_failed"]
    },
    {
      "id": "wrt_heater_ol",
      "when": { "type": "measurement", "knowledgeId": "whirlpoolWrtDefrostHeaterOhms", "statusIn": ["critical"] },
      "eliminate": ["defrost_heater_ok"],
      "confirm": ["defrost_heater_failed"]
    },
    {
      "id": "wrt_heater_normal",
      "when": { "type": "measurement", "knowledgeId": "whirlpoolWrtDefrostHeaterOhms", "statusIn": ["normal"] },
      "eliminate": ["defrost_heater_failed"],
      "confirm": ["defrost_heater_ok"]
    },
    {
      "id": "wrt_bimetal_ol",
      "when": { "type": "measurement", "knowledgeId": "whirlpoolWrtDefrostBimetalOhms", "statusIn": ["critical"] },
      "eliminate": ["defrost_thermostat_ok"],
      "confirm": ["defrost_thermostat_failed"]
    },
    {
      "id": "wrt_bimetal_good",
      "when": { "type": "measurement", "knowledgeId": "whirlpoolWrtDefrostBimetalOhms", "statusIn": ["normal"] },
      "eliminate": ["defrost_thermostat_failed"],
      "confirm": ["defrost_thermostat_ok"]
    },
    {
      "id": "wrt311_heater_ol",
      "when": { "type": "measurement", "knowledgeId": "whirlpoolWrt311DefrostHeaterOhms", "statusIn": ["critical"] },
      "eliminate": ["defrost_heater_ok"],
      "confirm": ["defrost_heater_failed"]
    },
    {
      "id": "wrt311_heater_normal",
      "when": { "type": "measurement", "knowledgeId": "whirlpoolWrt311DefrostHeaterOhms", "statusIn": ["normal"] },
      "eliminate": ["defrost_heater_failed"],
      "confirm": ["defrost_heater_ok"]
    },
    {
      "id": "wrt311_bimetal_ol",
      "when": { "type": "measurement", "knowledgeId": "whirlpoolWrt311DefrostBimetalOhms", "statusIn": ["critical"] },
      "eliminate": ["defrost_thermostat_ok"],
      "confirm": ["defrost_thermostat_failed"]
    },
    {
      "id": "wrt_cold_control_off",
      "when": { "type": "field", "path": "commonly_missed.cold_control_not_off", "equals": "unchecked" },
      "eliminate": ["cooling_off_cleared"],
      "confirm": ["cooling_off_active"]
    },
    {
      "id": "defrost_thermostat_ol",
      "when": { "type": "measurement", "knowledgeId": "defrostThermostatOhms", "statusIn": ["critical"] },
      "eliminate": ["defrost_thermostat_ok"],
      "confirm": ["defrost_thermostat_failed"]
    },
    {
      "id": "defrost_thermostat_good",
      "when": { "type": "measurement", "knowledgeId": "defrostThermostatOhms", "statusIn": ["normal"] },
      "eliminate": ["defrost_thermostat_failed"],
      "confirm": ["defrost_thermostat_ok"]
    },
    {
      "id": "defrost_fuse_ol",
      "when": { "type": "measurement", "knowledgeId": "defrostThermalFuseOhms", "statusIn": ["critical"] },
      "eliminate": ["defrost_fuse_ok"],
      "confirm": ["defrost_fuse_failed"]
    },
    {
      "id": "defrost_fuse_good",
      "when": { "type": "measurement", "knowledgeId": "defrostThermalFuseOhms", "statusIn": ["normal"] },
      "eliminate": ["defrost_fuse_failed"],
      "confirm": ["defrost_fuse_ok"]
    },
    {
      "id": "compressor_not_running",
      "when": { "type": "field", "path": "functional_checks.compressor_running", "equals": "no" },
      "eliminate": ["compressor_ok", "sealed_system_fault"],
      "confirm": ["compressor_failed"]
    },
    {
      "id": "compressor_not_running_demo_cleared",
      "when": [
        { "type": "field", "path": "functional_checks.compressor_running", "equals": "no" },
        { "type": "field", "path": "commonly_missed.cooling_off_ruled_out", "equals": "checked" }
      ],
      "eliminate": ["cooling_off_active"],
      "confirm": ["compressor_failed"]
    },
    {
      "id": "fans_on_comp_off_demo",
      "when": { "type": "field", "path": "functional_checks.fans_on_compressor_off", "equals": "yes" },
      "eliminate": ["cooling_off_cleared", "sealed_system_fault", "compressor_failed"],
      "confirm": ["cooling_off_active"]
    },
    {
      "id": "cooling_off_ruled_out",
      "when": { "type": "field", "path": "commonly_missed.cooling_off_ruled_out", "equals": "checked" },
      "eliminate": ["cooling_off_active"],
      "confirm": ["cooling_off_cleared"]
    },
    {
      "id": "compressor_running_low_amps",
      "when": { "type": "measurement", "knowledgeId": "compressorRunAmps", "statusIn": ["critical", "warning"] },
      "eliminate": ["compressor_ok"],
      "confirm": ["compressor_failed", "sealed_system_fault"]
    },
    {
      "id": "inverter_ipm_low",
      "when": { "type": "measurement", "knowledgeId": "refrigeratorInverterIpmVoltage", "statusIn": ["critical", "warning"] },
      "eliminate": ["inverter_ok"],
      "confirm": ["inverter_failed"]
    },
    {
      "id": "evap_fan_no",
      "when": { "type": "field", "path": "functional_checks.evaporator_fan_running", "equals": "no" },
      "eliminate": ["evap_fan_ok"],
      "confirm": ["evap_fan_failed"]
    },
    {
      "id": "evap_fan_feedback_low",
      "when": { "type": "measurement", "knowledgeId": "refrigeratorEvapFanFeedbackVoltage", "statusIn": ["critical"] },
      "eliminate": ["evap_fan_ok"],
      "confirm": ["evap_fan_failed"]
    },
    {
      "id": "condenser_fan_no",
      "when": { "type": "field", "path": "functional_checks.condenser_fan_running", "equals": "no" },
      "eliminate": ["condenser_fan_ok"],
      "confirm": ["condenser_fan_failed"]
    },
    {
      "id": "damper_bad",
      "when": { "type": "field", "path": "functional_checks.damper_operation", "equals": "bad" },
      "eliminate": ["damper_ok"],
      "confirm": ["damper_failed"]
    },
    {
      "id": "damper_good",
      "when": { "type": "field", "path": "functional_checks.damper_operation", "equals": "good" },
      "eliminate": ["damper_failed"],
      "confirm": ["damper_ok"]
    },
    {
      "id": "door_switch_bad",
      "when": { "type": "field", "path": "functional_checks.door_switch", "equals": "no" },
      "eliminate": ["door_switch_ok"],
      "confirm": ["door_switch_failed"]
    },
    {
      "id": "door_switch_good",
      "when": { "type": "field", "path": "functional_checks.door_switch", "equals": "yes" },
      "eliminate": ["door_switch_failed"],
      "confirm": ["door_switch_ok"]
    },
    {
      "id": "door_alignment_good",
      "when": { "type": "field", "path": "visual_inspection.door_alignment", "equals": "good" },
      "eliminate": ["door_alignment_fault"],
      "confirm": ["door_alignment_ok"]
    },
    {
      "id": "door_alignment_bad",
      "when": { "type": "field", "path": "visual_inspection.door_alignment", "equals": "bad" },
      "eliminate": ["door_alignment_ok"],
      "confirm": ["door_alignment_fault"]
    },
    {
      "id": "gasket_good",
      "when": { "type": "field", "path": "visual_inspection.gasket_condition", "equals": "good" },
      "eliminate": ["gasket_fault"],
      "confirm": ["gasket_ok"]
    },
    {
      "id": "gasket_bad",
      "when": { "type": "field", "path": "visual_inspection.gasket_condition", "equals": "bad" },
      "eliminate": ["gasket_ok"],
      "confirm": ["gasket_fault"]
    },
    {
      "id": "supply_critical",
      "when": { "type": "measurement", "knowledgeId": "supplyVoltage120", "statusIn": ["critical"] },
      "eliminate": ["supply_ok"],
      "confirm": ["supply_fault"]
    },
    {
      "id": "frost_chip",
      "when": { "type": "chip", "id": "frost_buildup" },
      "suspect": ["defrost_heater_failed", "evap_fan_failed"]
    },
    {
      "id": "heavy_frost_yes",
      "when": { "type": "field", "path": "visual_inspection.frost_present", "equals": "yes" },
      "suspect": ["evap_fan_failed", "defrost_heater_failed"]
    },
    {
      "id": "cooling_off_chip",
      "when": { "type": "chip", "id": "cooling_off" },
      "suspect": ["cooling_off_active"],
      "eliminate": ["sealed_system_fault"]
    },
    {
      "id": "weak_ff_damper_suspect",
      "when": { "type": "chip", "id": "weak_cooling_ff" },
      "suspect": ["damper_failed", "evap_fan_failed"]
    }
  ]
}
