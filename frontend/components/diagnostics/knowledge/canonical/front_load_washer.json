  "diagnosticPrinciples": {
    "general": [
      {
        "id": "upstream_before_downstream",
        "rule": "Establish required upstream conditions before condemning a downstream component."
      },
      {
        "id": "do_not_repeat_resolved_tests",
        "rule": "A component or domain already verified_good should not normally be retested unless contradictory evidence appears."
      },
      {
        "id": "normal_is_not_proof",
        "rule": "A normal measurement reduces failure likelihood without declaring the entire component verified_good."
      },
      {
        "id": "failed_command_changes_path",
        "rule": "If a load does not receive expected command or supply, investigate upstream control path before condemning the load."
      },
      {
        "id": "pressure_path_before_sensor",
        "rule": "Do not condemn water level sensor until pressure hose and air path are verified where applicable."
      },
      {
        "id": "lock_feedback_vs_mechanics",
        "rule": "Door lock mechanical operation and electrical feedback are separate failure modes."
      },
      {
        "id": "preserve_uncertainty",
        "rule": "Unknown, inaccessible, and unverified states must remain distinct from verified_good."
      }
    ]
  },
  "diagnosticEntryPoints": [
    {
      "id": "dead",
      "symptoms": ["completely dead", "no display", "no response", "no power"],
      "initialDomains": ["power_failure", "control_failure"]
    },
    {
      "id": "wont_start",
      "symptoms": ["won't start", "pressing start does nothing", "cycle will not begin"],
      "initialDomains": ["user_interface_failure", "control_failure", "door_interlock_failure", "power_failure"]
    },
    {
      "id": "wont_fill",
      "symptoms": ["won't fill", "no water", "slow fill", "LF", "F20", "4C"],
      "initialDomains": ["fill_failure", "door_interlock_failure", "water_level_failure", "control_failure"]
    },
    {
      "id": "overfills",
      "symptoms": ["overfills", "too much water", "does not stop filling", "OC"],
      "initialDomains": ["water_level_failure", "fill_failure", "control_failure"]
    },
    {
      "id": "wont_drain",
      "symptoms": ["won't drain", "water remains", "slow drain", "F21", "5C", "LC"],
      "initialDomains": ["drain_failure", "water_level_failure", "control_failure"]
    },
    {
      "id": "wont_spin",
      "symptoms": ["won't spin", "does not spin", "no high-speed spin", "F25", "F28", "3C"],
      "initialDomains": ["drive_failure", "drain_failure", "water_level_failure", "door_interlock_failure", "mechanical_failure", "control_failure"],
      "activeGoals": ["spin_authorization", "drive_operation"]
    },
    {
      "id": "wont_tumble",
      "symptoms": ["won't tumble", "drum does not rotate", "no agitation"],
      "initialDomains": ["drive_failure", "door_interlock_failure", "mechanical_failure", "control_failure"]
    },
