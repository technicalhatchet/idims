  "functionalDependencies": [
    {
      "id": "cycle_start_authorization",
      "description": "Normal cycle start requires valid user input, control readiness, and acceptable door/interlock state.",
      "requires": ["hmi_control", "control_board", "door_lock"],
      "enables": ["water_fill", "drive_operation"]
    },
    {
      "id": "water_fill",
      "description": "Fill requires authorization, water supply, operable inlet valve, and level feedback path.",
      "requires": ["control_board", "door_lock", "inlet_valve", "supply"],
      "feedback": ["water_level_sensor"],
      "conditional": ["pressure_hose", "pressure_chamber"]
    },
    {
      "id": "drain_completion",
      "description": "Drain requires pump/path function and control recognition of resulting level change.",
      "requires": ["control_board", "drain_pump"],
      "feedback": ["water_level_sensor"],
      "conditional": ["pressure_hose", "pressure_chamber"]
    },
    {
      "id": "drive_operation",
      "description": "Motor operation requires cycle authorization, acceptable water/drain state, motor path, and feedback where used.",
      "requires": ["control_board", "door_lock", "drive_motor"],
      "conditional": ["motor_controller", "water_level_sensor", "drain_pump", "suspension", "drum_bearing"]
    },
    {
      "id": "heating_operation",
      "description": "Heating requires control request, heater continuity, switching path, and valid temperature feedback.",
      "requires": ["control_board", "wash_heater"],
      "conditional": ["wash_ntc"]
    },
    {
      "id": "dispense_operation",
      "description": "Dispensing requires fill authorization, valve routing, and clear dispenser path.",
      "requires": ["control_board", "inlet_valve"],
      "conditional": ["dosing_pump", "bulk_level_switch"]
    },
    {
      "id": "spin_authorization",
      "description": "High-speed spin generally requires locked door, drained tub, and acceptable balance/level state.",
      "requires": ["door_lock", "drain_pump", "water_level_sensor"],
      "conditional": ["suspension", "drive_motor"]
    }
  ],
