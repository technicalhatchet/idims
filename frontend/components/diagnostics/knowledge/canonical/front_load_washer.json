{
  "schemaVersion": "1.0.0",
  "ontology": {
    "id": "front_load_washer",
    "name": "Front-Load Washer",
    "templateId": "washer",
    "variant": "front_load",
    "description": "Canonical functional and diagnostic ontology for front-load washing machines. Component ids align with Solomon evidence graph where established."
  },
  "designPrinciples": [
    "The canonical graph represents functional relationships that matter to diagnosis, not every physical wire.",
    "Manufacturer and model implementations extend this graph via platform overlays — they do not replace it.",
    "Tests produce evidence; evidence changes component and hypothesis state (handled in procedure + intelligence layers).",
    "A normal measurement reduces likelihood of a failure mode but does not prove the entire component verified_good.",
    "Do not condemn a downstream component until required upstream conditions are established.",
    "Unknown information must remain unknown — never infer good or bad without evidence.",
    "Procedure branch logic and test definitions stay in service procedure seeds, not in this file."
  ],
  "relationshipTypes": [
    "supplies",
    "controls",
    "commands",
    "provides_feedback_to",
    "communicates_with",
    "senses",
    "mechanically_drives",
    "mechanically_connected_to",
    "hydraulically_connects_to",
    "depends_on",
    "enables",
    "inhibits",
    "reports_level_through"
  ],
  "componentStateModel": {
    "description": "Target state vocabulary for Phase 2+ engine integration. Current intelligence engine uses unknown|confirmed|unlikely|eliminated.",
    "states": [
      "unknown",
      "unverified",
      "suspected",
      "supported",
      "conditionally_supported",
      "contradicted",
      "verified_good",
      "verified_failed",
      "not_applicable",
      "inaccessible"
    ],
    "terminalStates": [
      "verified_good",
      "verified_failed",
      "not_applicable"
    ],
    "intelligenceEngineMapping": {
      "confirmed": "verified_failed",
      "unlikely": "supported",
      "eliminated": "verified_good",
      "unknown": "unknown",
      "_note": "DS-6: procedure confirm without explicit failure rule maps to unlikely/supported, not confirmed/verified_failed"
    }
  },
