  "diagnosticPrinciples": {
    "general": [
      { "id": "upstream_before_downstream", "rule": "Establish authorization and prerequisites before condemning downstream loads." },
      { "id": "fill_before_circulation", "rule": "Establish correct fill and water level before treating circulation as the primary fault." },
      { "id": "drain_before_heat", "rule": "Establish appropriate water state before diagnosing heating behavior." },
      { "id": "command_before_load", "rule": "Separate command evidence from load operation evidence." },
      { "id": "heater_command_before_current", "rule": "Do not condemn the heat source until command state and load current are distinguished." },
      { "id": "temperature_response_after_heater", "rule": "Heating current does not by itself prove effective temperature rise." },
      { "id": "normal_is_not_proof", "rule": "Normal operation supports a hypothesis but does not independently verify component health." },
      { "id": "preserve_uncertainty", "rule": "Negative or incomplete evidence should reduce candidate support without manufacturing verification." }
    ]
  },
