  "functionalDependencies": [
    {
      "id": "cycle_start_authorization",
      "description": "Dry cycle start requires valid user input, control readiness, and acceptable door state.",
      "requires": ["hmi_control", "control_board", "door_switch", "power_supply"],
      "enables": ["drive_operation", "airflow_operation"]
    },
    {
      "id": "door_authorization",
      "description": "Drive and heat loads require closed-door authorization feedback.",
      "requires": ["door_switch", "control_board"],
      "enables": ["drive_operation", "heating_operation"]
    },
    {
      "id": "drive_operation",
      "description": "Tumble requires door authorization, motor command, and mechanical drive path.",
      "requires": ["control_board", "door_switch", "drive_motor"],
      "conditional": ["drum"]
    },
    {
      "id": "airflow_operation",
      "description": "Drying airflow requires blower and unobstructed lint filter and exhaust path.",
      "requires": ["control_board", "blower", "lint_filter", "exhaust_path"],
      "conditional": ["drum"]
    },
    {
      "id": "heated_airflow_path",
      "description": "Functional air path: heat_source → drum → lint_filter → blower → exhaust_path.",
      "requires": ["heat_source", "drum", "lint_filter", "blower", "exhaust_path"],
      "enables": ["heating_operation"]
    },
    {
      "id": "heating_operation",
      "description": "Heat requires control command, intact heat_source, thermal protection in series, airflow path, and temperature feedback where used.",
      "requires": ["control_board", "heat_source", "door_switch", "airflow_operation"],
      "feedback": ["temperature_sensor"],
      "conditional": ["thermal_fuse", "thermal_cutoff", "heated_airflow_path"]
    },
    {
      "id": "dry_termination",
      "description": "Automatic cycle end uses moisture and/or temperature feedback depending on platform.",
      "requires": ["control_board"],
      "feedback": ["moisture_sensor", "temperature_sensor"]
    }
  ],
