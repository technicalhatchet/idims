  "diagnosticPrinciples": {
    "general": [
      {
        "id": "upstream_before_downstream",
        "rule": "Establish door authorization, motor run, and blower before condemning the heat source."
      },
      {
        "id": "command_before_load",
        "rule": "Verify control command before replacing a load that never received voltage or heat output."
      },
      {
        "id": "lint_vs_exhaust_distinction",
        "rule": "Clogged lint filter and restricted external vent are different failure modes — blower may run normally in both."
      },
      {
        "id": "restricted_vent_not_no_blower",
        "rule": "Restricted vent does not imply blower failure or heat source failure — expect long dry times and overheating symptoms."
      },
      {
        "id": "thermal_protection_before_heat_source",
        "rule": "Open thermal fuse or cutoff explains no heat with otherwise good heat_source — test protection in series path."
      },
      {
        "id": "control_feedback_vs_hard_protection",
        "rule": "Temperature sensor feedback (control loop) is distinct from thermal fuse/cutoff (hard protection)."
      },
      {
        "id": "normal_is_not_proof",
        "rule": "A normal measurement reduces failure likelihood without declaring the entire component verified_good."
      },
      {
        "id": "preserve_uncertainty",
        "rule": "Unknown, inaccessible, and unverified states must remain distinct from verified_good."
      }
    ]
  },
  "diagnosticEntryPoints": [
    {
      "id": "wont_start",
      "symptoms": ["won't start", "no response", "pressing start does nothing", "cycle will not begin"],
      "initialDomains": ["power_failure", "user_interface_failure", "control_failure", "door_authorization_failure"],
      "activeGoals": ["cycle_start_authorization"]
    },
    {
      "id": "wont_tumble",
      "symptoms": ["won't tumble", "drum does not turn", "no rotation", "motor does not run"],
      "initialDomains": ["drive_failure", "door_authorization_failure", "control_failure"],
      "activeGoals": ["drive_operation", "door_authorization"]
    },
    {
      "id": "no_heat",
      "symptoms": ["no heat", "not heating", "clothes stay cold", "air not hot"],
      "initialDomains": ["heating_failure", "blower_failure", "lint_filter_failure", "exhaust_path_failure", "control_failure", "temperature_sensing_failure"],
      "activeGoals": ["heating_operation", "airflow_operation"]
    },
    {
      "id": "overheating",
      "symptoms": ["overheating", "too hot", "scorching", "high exhaust temperature"],
      "initialDomains": ["heating_failure", "temperature_sensing_failure", "lint_filter_failure", "exhaust_path_failure", "installation_external", "control_failure"],
      "activeGoals": ["heating_operation", "airflow_operation"]
    },
    {
      "id": "takes_too_long_to_dry",
      "symptoms": ["takes too long", "long dry times", "still damp", "extended cycle"],
      "initialDomains": ["lint_filter_failure", "exhaust_path_failure", "heating_failure", "blower_failure", "moisture_sensing_failure", "installation_external"],
      "activeGoals": ["airflow_operation", "heating_operation", "dry_termination"]
    },
    {
      "id": "shuts_down_early",
      "symptoms": ["stops early", "shuts off prematurely", "cycle ends too soon"],
      "initialDomains": ["moisture_sensing_failure", "temperature_sensing_failure", "control_failure", "heating_failure"],
      "activeGoals": ["dry_termination"]
    }
  ]
}
