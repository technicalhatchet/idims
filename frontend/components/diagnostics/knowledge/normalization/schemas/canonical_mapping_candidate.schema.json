{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CanonicalMappingCandidate",
  "type": "object",
  "required": ["id", "status", "candidateType", "sourceTerm", "confidence", "provenance"],
  "properties": {
    "id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["candidate", "validated", "approved", "rejected", "UNRESOLVED_TERM", "COMPOUND_TERM_CANDIDATE", "CONFLICT_REQUIRES_REVIEW"]
    },
    "candidateType": { "const": "canonicalMapping" },
    "sourceTerm": { "type": "string" },
    "canonicalId": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "mappingType": { "type": "string", "enum": ["alias", "compound_alias", "seed_component_id", "component", "relationship"] },
    "seedComponentId": { "type": ["string", "null"] },
    "reviewLevel": { "type": ["string", "null"] },
    "decomposition": { "type": "object" },
    "matchedPhrase": { "type": ["string", "null"] },
    "provenance": { "type": "object" }
  }
}
