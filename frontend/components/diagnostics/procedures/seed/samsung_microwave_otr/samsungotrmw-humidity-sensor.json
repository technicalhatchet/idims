          },
          "nextStepId": "replace_sensor_heater",
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "supply",
              "evidenceId": "confirm_supply_critical_supply_fault"
            }
          ]
        },
        {
          "id": "replace_pcb_sensor_crit",
          "label": "Out of spec",
          "when": {
            "kind": "measurement_critical"
          },
          "nextStepId": "replace_sensor_heater",
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "supply",
              "evidenceId": "confirm_supply_critical_supply_fault"
            }
          ]
        },
        {
          "id": "replace_pcb_sensor_open",
          "label": "Open (OL)",
          "when": {
            "kind": "measurement_open"
          },
          "nextStepId": "replace_sensor_heater",
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "supply",
              "evidenceId": "confirm_supply_critical_supply_fault"
            }
          ]
        }
