      "id": "safety_power_off",
      "order": 1,
      "type": "safety",
      "title": "Disconnect power and discharge HV",
      "body": "Unplug the microwave or disconnect power before servicing. Discharge the high-voltage capacitor and vent run capacitor before touching HV or blower circuits. Never operate the unit with interlock switches bypassed.",
      "sourceExcerpt": "Before touching any oven components or wiring, always unplug the oven and discharge the high voltage capacitor.",
      "requiresInput": false,
      "defaultNextStepId": "quick_test_result"
    },
    {
      "id": "service_mode_before_sensor_test",
      "type": "instruction",
      "title": "Continue after sensor quick test",
      "body": "Sensor quick test entered (Auto Defrost + Popcorn hold). Continue with fault interpretation below.",
      "sourceExcerpt": "\u00a74-14 SENSOR TEST (QUICK TEST) \u2014 Auto Defrost and Popcorn pads.",
      "requiresInput": false,
      "order": 2,
      "defaultNextStepId": "quick_test_result"
    },
    {
      "id": "quick_test_result",
      "order": 3,
      "type": "visual_check",
      "title": "Quick test display 15\u2013185?",
      "body": "Standby: hold Auto Defrost + Popcorn \u2014 normal range 15\u2013185. \u2265213 = open/unplugged; <6 = shorted.",
      "sourceExcerpt": "15-185 Normal; 213 or Higher failed; Less then 6 shorted.",
      "requiresInput": true,
      "branches": [
        {
          "id": "sensor_connected_yes",
          "label": "Yes / OK",
          "when": {
            "kind": "checkpoint_yes"
          },
          "nextStepId": "sensor_connected"
        },
        {
          "id": "sensor_connected_no",
          "label": "No / failed",
          "when": {
            "kind": "checkpoint_no"
          },
          "nextStepId": "sensor_heater_ohms",
          "diagnosticEffects": [
            {
              "type": "suspect",
              "componentId": "supply"
            }
          ]
        }
      ]
    },
    {
      "id": "sensor_connected",
      "order": 4,
      "type": "visual_check",
      "title": "Sensor connector seated at CN250?",
      "body": "Inspect gas sensor connector and housing in vent area (top left cavity).",
      "sourceExcerpt": "Inspect gas sensor connector and housing in vent area (top left cavity).",
      "requiresInput": true,
      "branches": [
        {
          "id": "replace_sensor_yes",
          "label": "Yes / OK",
          "when": {
            "kind": "checkpoint_yes"
          },
          "nextStepId": "replace_sensor",
          "diagnosticEffects": [
            {
              "type": "eliminate",
              "componentId": "supply",
              "evidenceId": "eliminate_supply_critical_supply_ok"
            }
          ]
        },
        {
          "id": "replace_sensor_no",
          "label": "No / failed",
          "when": {
            "kind": "checkpoint_no"
          },
          "nextStepId": "reseat_sensor",
          "diagnosticEffects": [
            {
              "type": "suspect",
              "componentId": "supply"
            }
          ]
        }
      ]
    },
    {
      "id": "reseat_sensor",
      "order": 5,
      "type": "instruction",
      "title": "Reseat sensor connector",
      "body": "Connect sensor wire properly and retest quick test.",
      "sourceExcerpt": "Connect sensor wire properly and retest quick test.",
      "requiresInput": false,
      "defaultNextStepId": "quick_test_result"
    },
    {
      "id": "sensor_heater_ohms",
      "order": 6,
      "type": "measurement",
      "title": "Sensor heater terminals (H) ~30 \u03a9",
      "body": "Only Black and Red heater leads \u2014 do NOT ohm White/Orange sensor terminals.",
      "sourceExcerpt": "Only heater terminals (H; Black and Red leads) can be checked with ohmmeter (30\u03a9).",
      "measurementKnowledgeId": "samsungMe11HumiditySensorHeaterOhms",
      "testPoint": {
        "connector": "CN250",
        "pins": "H Black-Red",
        "label": "Sensor heater terminals (H) ~30 \u03a9"
      },
      "requiresInput": true,
      "branches": [
        {
          "id": "replace_pcb_sensor_pass",
          "label": "Within spec",
          "when": {
            "kind": "measurement_normal"
          },
          "nextStepId": "replace_pcb_sensor",
          "diagnosticEffects": [
            {
              "type": "eliminate",
