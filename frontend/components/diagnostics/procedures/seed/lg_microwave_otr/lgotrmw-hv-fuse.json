      "order": 1,
      "type": "safety",
      "title": "Disconnect power and discharge HV",
      "body": "Unplug the microwave or disconnect power before servicing. Discharge the high-voltage capacitor before touching any HV component. Never operate the unit with interlock switches bypassed.",
      "sourceExcerpt": "DISCONNECT THE POWER SUPPLY CORD FROM THE OUTLET WHENEVER REMOVING THE OUTER CASE.",
      "requiresInput": false,
      "defaultNextStepId": "hv_fuse_ohms"
    },
    {
      "id": "hv_fuse_ohms",
      "order": 2,
      "type": "measurement",
      "title": "HV fuse resistance",
      "body": "Remove leads. HV fuse should read under 10 \u03a9.",
      "sourceExcerpt": "Normal : under 10ohm",
      "measurementKnowledgeId": "lgMicrowaveOtrHvFuseOhms",
      "testPoint": {
        "connector": "HV fuse",
        "pins": "both ends",
        "label": "HV fuse resistance"
      },
      "requiresInput": true,
      "branches": [
