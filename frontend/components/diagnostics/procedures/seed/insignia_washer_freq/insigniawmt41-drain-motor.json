        },
        {
          "id": "drain_warn",
          "label": "Outside range",
          "when": {
            "kind": "measurement_warning"
          },
          "nextStepId": "replace_retractor",
          "terminal": true,
          "oemOutcome": "Replace component \u2014 out of spec.",
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "drain_pump",
              "evidenceId": "confirm_drain_pump_ol_drain_pump_failed"
            }
          ]
        },
        {
          "id": "drain_crit",
          "label": "Critical out of range",
          "when": {
            "kind": "measurement_critical"
          },
          "nextStepId": "replace_retractor",
          "terminal": true,
          "oemOutcome": "Replace component \u2014 out of spec.",
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "drain_pump",
              "evidenceId": "confirm_drain_pump_ol_drain_pump_failed"
            }
          ]
        },
        {
          "id": "drain_pass",
          "label": "In range",
          "when": {
            "kind": "measurement_normal"
