          "nextStepId": "drain_verified",
          "diagnosticEffects": [
            {
              "type": "eliminate",
              "componentId": "drain_pump",
              "evidenceId": "eliminate_drain_pump_ol_drain_pump_ok"
            }
          ]
        }
      ]
    },
    {
