      },
      "requiresInput": true,
      "branches": [
        {
          "id": "5v_open",
          "label": "Open (OL)",
          "when": {
            "kind": "measurement_open"
          },
          "nextStepId": "replace_sub_pcb",
          "terminal": true,
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "supply",
              "evidenceId": "confirm_supply_critical_supply_fault"
            }
          ]
        },
        {
          "id": "5v_warn",
          "label": "Outside range",
          "when": {
            "kind": "measurement_warning"
          },
          "nextStepId": "replace_sub_pcb",
          "terminal": true,
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "supply",
              "evidenceId": "confirm_supply_critical_supply_fault"
            }
          ]
        },
        {
          "id": "5v_crit",
          "label": "Critical",
          "when": {
            "kind": "measurement_critical"
          },
          "nextStepId": "replace_sub_pcb",
          "terminal": true,
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "supply",
              "evidenceId": "confirm_supply_critical_supply_fault"
            }
          ]
        },
        {
          "id": "5v_pass",
          "label": "5 V present",
          "when": {
            "kind": "measurement_normal"
          },
          "nextStepId": "power_ok"
        }
      ]
    },
    {
      "id": "replace_cord",
      "order": 7,
      "type": "outcome",
      "title": "Replace cord",
      "oemOutcome": "Replace power cord or restore supply when L\u2013N not 120 VAC.",
      "requiresInput": false
    },
    {
      "id": "repair_harness",
      "order": 8,
      "type": "outcome",
      "title": "Repair harness",
      "oemOutcome": "Reconnect or replace display/main harness.",
