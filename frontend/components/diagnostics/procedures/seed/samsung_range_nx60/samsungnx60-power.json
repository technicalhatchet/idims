  "steps": [
    {
      "id": "safety_power_off",
      "order": 1,
      "type": "safety",
      "title": "Disconnect power and gas",
      "body": "Turn off gas supply and disconnect electrical power before servicing. Use appropriate PPE for live voltage checks.",
      "sourceExcerpt": "Turn off the gas supply before working on/servicing the appliance. Disconnect power before working on electrical parts.",
      "requiresInput": false,
      "defaultNextStepId": "apply_power_check"
    },
    {
      "id": "apply_power_check",
      "order": 2,
      "type": "instruction",
      "title": "Restore power for voltage test",
      "body": "Plug in cord or reset breaker. Measure input voltage at plug \u2014 120 VAC L\u2013N.",
      "sourceExcerpt": "Plug in cord or reset breaker. Measure input voltage at plug \u2014 120 VAC L\u2013N.",
      "requiresInput": false,
      "defaultNextStepId": "board_voltage"
    },
    {
      "id": "service_mode_after_entry",
      "type": "instruction",
      "title": "Continue procedure",
      "body": "Service mode entered. Continue with component-specific OEM checks below.",
      "sourceExcerpt": "After error recall or sub-line test entry, proceed with component tests.",
      "requiresInput": false,
      "order": 3,
      "defaultNextStepId": "board_voltage"
    },
    {
      "id": "board_voltage",
      "order": 4,
      "type": "measurement",
      "title": "Main PCB supply voltage",
      "body": "CNP100 on Main PCB pin 5\u20137 \u2014 120 VAC with power applied.",
      "sourceExcerpt": "CNP100 on Main PCB pin 5\u20137 \u2014 120 VAC with power applied.",
      "measurementKnowledgeId": "supplyVoltage120",
      "testPoint": {
        "connector": "CNP100",
        "pins": "5 \u2194 7",
        "label": "Main PCB supply voltage"
      },
      "requiresInput": true,
      "branches": [
        {
          "id": "pwr_open",
          "label": "Open (OL)",
          "when": {
            "kind": "measurement_open"
          },
          "nextStepId": "replace_cord",
          "terminal": true,
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "supply",
              "evidenceId": "confirm_supply_critical_supply_fault"
            }
          ]
        },
        {
          "id": "pwr_warn",
          "label": "Outside range",
          "when": {
            "kind": "measurement_warning"
          },
          "nextStepId": "replace_cord",
          "terminal": true,
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "supply",
              "evidenceId": "confirm_supply_critical_supply_fault"
            }
          ]
        },
        {
          "id": "pwr_crit",
          "label": "Critical",
          "when": {
            "kind": "measurement_critical"
          },
          "nextStepId": "replace_cord",
          "terminal": true,
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "supply",
              "evidenceId": "confirm_supply_critical_supply_fault"
            }
          ]
        },
        {
          "id": "pwr_pass",
          "label": "120 VAC",
          "when": {
            "kind": "measurement_normal"
          },
          "nextStepId": "harness_ok"
        }
      ]
    },
    {
      "id": "harness_ok",
      "order": 5,
      "type": "visual_check",
      "title": "Harness and display connections",
      "body": "Verify CN220/CN430 display harness and CN100 sub\u2194main connections seated.",
      "sourceExcerpt": "Verify CN220/CN430 display harness and CN100 sub\u2194main connections seated.",
      "requiresInput": true,
      "branches": [
        {
          "id": "harness_yes",
          "label": "Yes / OK",
          "when": {
            "kind": "checkpoint_yes"
          },
          "nextStepId": "display_5v"
        },
        {
          "id": "harness_no",
          "label": "No / fault",
          "when": {
            "kind": "checkpoint_no"
          },
          "nextStepId": "repair_harness",
          "terminal": true,
          "oemOutcome": "Repair or replace loose harness."
        }
      ]
    },
    {
      "id": "display_5v",
      "order": 6,
      "type": "measurement",
      "title": "Display 5 V supply",
      "body": "CN430 pins 1\u20132 \u2014 5 VDC on Sub PCB when powered.",
      "sourceExcerpt": "CN430 pins 1\u20132 \u2014 5 VDC on Sub PCB when powered.",
      "measurementKnowledgeId": "supplyVoltage120",
      "testPoint": {
        "connector": "CN430",
        "pins": "1 \u2194 2 (5 VDC)",
