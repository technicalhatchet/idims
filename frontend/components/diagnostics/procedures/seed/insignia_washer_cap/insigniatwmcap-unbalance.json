          "nextStepId": "replace_magnet_switch_e4",
          "terminal": true,
          "oemOutcome": "Replace magnetic switch.",
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "suspension",
              "evidenceId": "confirm_unbalance_load"
            }
          ]
        }
      ]
    },
    {
      "id": "redistribute_load",
      "order": 7,
      "type": "outcome",
      "title": "Redistribute load",
      "oemOutcome": "Balance laundry; unit retries up to 3 times before E4.",
      "requiresInput": false
    },
    {
      "id": "level_washer",
      "order": 8,
      "type": "outcome",
      "title": "Level washer",
      "oemOutcome": "Adjust feet for level installation.",
      "requiresInput": false
    },
    {
      "id": "replace_impact_switch",
      "order": 9,
      "type": "outcome",
      "title": "Replace impact switch",
      "oemOutcome": "Replace impact/collision switch (E5 on TWM35/WMT family).",
      "requiresInput": false
    },
    {
      "id": "replace_magnet_switch_e4",
      "order": 10,
      "type": "outcome",
      "title": "Replace magnetic switch",
      "oemOutcome": "Replace lid magnetic switch.",
      "requiresInput": false
    },
    {
      "id": "unbalance_verified",
      "order": 11,
      "type": "outcome",
      "title": "Mechanical path OK",
      "oemOutcome": "Load, level, and switches OK \u2014 if E4/E5 persists, replace PCB.",
      "requiresInput": false
    }
