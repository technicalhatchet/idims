      "order": 2,
      "defaultNextStepId": "load_balance"
    },
    {
      "id": "load_balance",
      "order": 3,
      "type": "visual_check",
      "title": "Load distribution",
      "body": "Clothes evenly distributed in basket? Washer on level solid floor?",
      "sourceExcerpt": "Clothes evenly distributed in basket? Washer on level solid floor?",
      "requiresInput": true,
      "branches": [
        {
          "id": "load_ok",
          "label": "Yes / OK",
          "when": {
            "kind": "checkpoint_yes"
          },
          "nextStepId": "washer_level"
        },
        {
          "id": "load_bad",
          "label": "No / fault",
          "when": {
            "kind": "checkpoint_no"
          },
          "nextStepId": "redistribute_load",
          "terminal": true,
          "oemOutcome": "Redistribute laundry evenly and retest spin.",
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "suspension",
              "evidenceId": "confirm_unbalance_load"
            }
          ]
        }
      ]
    },
    {
      "id": "washer_level",
      "order": 4,
      "type": "visual_check",
      "title": "Washer leveling",
      "body": "All leveling legs adjusted so washer is level and not touching walls?",
      "sourceExcerpt": "All leveling legs adjusted so washer is level and not touching walls?",
      "requiresInput": true,
      "branches": [
        {
          "id": "level_ok",
          "label": "Yes / OK",
          "when": {
            "kind": "checkpoint_yes"
          },
          "nextStepId": "impact_switch"
        },
        {
          "id": "level_bad",
          "label": "No / fault",
          "when": {
            "kind": "checkpoint_no"
          },
          "nextStepId": "level_washer",
          "terminal": true,
          "oemOutcome": "Adjust leveling legs.",
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "suspension",
              "evidenceId": "confirm_unbalance_load"
            }
          ]
        }
      ]
    },
    {
      "id": "impact_switch",
      "order": 5,
      "type": "visual_check",
      "title": "Impact switch (E5)",
      "body": "Impact switch: push bar to alternate position \u2014 resistance changes? Open-circuit at rest or short when pressed = replace.",
      "sourceExcerpt": "Impact switch: push bar to alternate position \u2014 resistance changes? Open-circuit at rest or short when pressed = replace.",
      "requiresInput": true,
      "branches": [
        {
          "id": "impact_ok",
          "label": "Yes / OK",
          "when": {
            "kind": "checkpoint_yes"
          },
          "nextStepId": "magnet_switch_e4"
        },
        {
          "id": "impact_bad",
          "label": "No / fault",
          "when": {
            "kind": "checkpoint_no"
          },
          "nextStepId": "replace_impact_switch",
          "terminal": true,
          "oemOutcome": "Replace impact switch.",
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "suspension",
              "evidenceId": "confirm_unbalance_load"
            }
          ]
        }
      ]
    },
    {
      "id": "magnet_switch_e4",
      "order": 6,
      "type": "visual_check",
      "title": "Magnetic switch (E4 path)",
      "body": "Place magnetic iron near switch \u2014 resistance OK? Short-circuit = replace switch.",
      "sourceExcerpt": "Place magnetic iron near switch \u2014 resistance OK? Short-circuit = replace switch.",
      "requiresInput": true,
      "branches": [
        {
          "id": "magnet_e4_ok",
          "label": "Yes / OK",
          "when": {
            "kind": "checkpoint_yes"
          },
          "nextStepId": "unbalance_verified"
        },
        {
          "id": "magnet_e4_bad",
          "label": "No / fault",
          "when": {
            "kind": "checkpoint_no"
