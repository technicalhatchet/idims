    },
    {
      "id": "ipm_voltage",
      "order": 3,
      "type": "instruction",
      "title": "IPM DC bus voltage",
      "body": "Verify inverter DC output \u2014 under 13.5 V indicates comp starting failure.",
      "sourceExcerpt": "Verify inverter DC output \u2014 under 13.5 V indicates comp starting failure.",
      "requiresInput": false,
      "defaultNextStepId": "ipm_read"
    },
    {
      "id": "service_mode_continue",
      "type": "instruction",
      "title": "Continue diagnostic",
