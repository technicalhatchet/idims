      "order": 5,
      "type": "measurement",
      "title": "Inverter IPM voltage",
      "body": "Read IPM DC supply \u2014 must be \u226513.5 V for reliable start.",
      "sourceExcerpt": "Read IPM DC supply \u2014 must be \u226513.5 V for reliable start.",
      "measurementKnowledgeId": "samsungBespokeFridgeInverterIpmVoltage",
      "testPoint": {
