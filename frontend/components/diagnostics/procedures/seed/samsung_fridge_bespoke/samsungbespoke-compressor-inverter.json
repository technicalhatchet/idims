        {
          "id": "ipm_warn",
          "label": "Marginal",
          "when": {
            "kind": "measurement_warning"
          },
          "nextStepId": "replace_inverter",
          "terminal": true,
          "diagnosticEffects": [
            {
              "action": "confirm",
              "evidenceId": "ref_ms_inverter_ipm_low",
              "componentId": "inverter_board"
            }
          ]
        },
        {
          "id": "ipm_pass",
          "label": "In range",
          "when": {
            "kind": "measurement_normal"
          },
          "nextStepId": "comp_ok"
        }
      ]
    },
    {
      "id": "short_out",
      "order": 6,
      "type": "outcome",
      "title": "Repair short",
      "oemOutcome": "Clear compressor or harness short before retest.",
