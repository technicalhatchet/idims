  "steps": [
    {
      "id": "safety_power_off",
      "order": 1,
      "type": "safety",
      "title": "Disconnect power",
      "body": "Unplug the washer or disconnect power before servicing. Replace all parts and panels before operating.",
      "sourceExcerpt": "Resistance checks must be made with washer unplugged or power disconnected.",
      "requiresInput": false,
      "defaultNextStepId": "access_console"
    },
    {
      "id": "access_console",
      "order": 2,
      "type": "instruction",
      "title": "Access main control",
      "body": "Remove console. Verify ALL connectors fully seated at ACU.",
      "sourceExcerpt": "Remove console. Verify ALL connectors fully seated at ACU.",
      "requiresInput": false,
      "defaultNextStepId": "restore_power_line"
    },
    {
      "id": "restore_power_line",
      "order": 3,
      "type": "instruction",
      "title": "Restore power for line check",
      "body": "Plug in or reconnect power for live measurements only.",
      "sourceExcerpt": "Plug in or reconnect power for live measurements only.",
      "requiresInput": false,
      "defaultNextStepId": "line_voltage"
    },
    {
      "id": "line_voltage",
      "order": 4,
      "type": "measurement",
      "title": "Line voltage J1-1 to J1-2",
      "body": "AC voltmeter: black probe J1-1 (Neutral), red probe J1-2 (Line). Expect 120 VAC.",
      "sourceExcerpt": "AC voltmeter: black probe J1-1 (Neutral), red probe J1-2 (Line). Expect 120 VAC.",
      "measurementKnowledgeId": "supplyVoltage120",
      "testPoint": {
        "connector": "J1",
        "pins": "1 & 2",
        "label": "Line voltage J1-1 to J1-2",
        "pinDetails": [
          {
            "pin": "1",
            "signal": "Neutral",
            "wireColor": "WH",
            "wireColorConfidence": "verified"
          },
          {
            "pin": "2",
            "signal": "Line",
            "wireColor": "BK",
            "wireColorConfidence": "verified"
          }
        ]
      },
      "requiresInput": true,
      "branches": [
        {
          "id": "line_ok",
          "label": "120 VAC present",
          "when": {
            "kind": "measurement_normal"
          },
          "nextStepId": "status_led",
          "diagnosticEffects": [
            {
              "type": "eliminate",
              "componentId": "supply",
              "evidenceId": "eliminate_supply_critical_supply_ok"
            }
          ]
        },
        {
          "id": "line_bad",
          "label": "No line voltage",
          "when": {
            "kind": "measurement_critical"
          },
          "nextStepId": "check_power_cord",
          "terminal": true,
          "oemOutcome": "Check outlet, breaker, and AC power cord continuity.",
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "supply",
              "evidenceId": "confirm_supply_critical_supply_fault"
            }
          ]
        }
      ]
    },
    {
      "id": "status_led",
      "order": 5,
      "type": "visual_check",
      "title": "ACU status LED state",
      "body": "After power-up: rapid flash then slow blink = micro OK. Steady ON = control malfunction. OFF = no 5 VDC. Rapid flash >30 sec or 2-quick-flash pattern = comm/load fault.",
      "sourceExcerpt": "After power-up: rapid flash then slow blink = micro OK. Steady ON = control malfunction. OFF = no 5 VDC. Rapid flash >30 sec or 2-quick-flash pattern = comm/load fault.",
      "requiresInput": true,
      "branches": [
        {
          "id": "led_ok",
          "label": "Slow blink during operation (ACU OK)",
          "when": {
            "kind": "checkpoint_yes"
          },
          "nextStepId": "acu_verified",
          "diagnosticEffects": [
            {
              "type": "eliminate",
              "componentId": "supply",
              "evidenceId": "eliminate_supply_critical_supply_ok"
            }
          ]
        },
        {
          "id": "led_off",
          "label": "OFF (no 5 VDC)",
          "when": {
            "kind": "checkpoint_no"
          },
          "nextStepId": "isolate_j5",
          "diagnosticEffects": [
            {
              "type": "suspect",
              "componentId": "supply"
            }
          ]
        },
        {
          "id": "led_steady",
          "label": "Steady ON or rapid fault pattern",
          "when": {
            "kind": "checkpoint_no"
          },
          "nextStepId": "replace_acu",
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "supply",
              "evidenceId": "confirm_supply_critical_supply_fault"
            }
          ]
        }
      ]
    },
    {
      "id": "isolate_j5",
      "order": 6,
      "type": "instruction",
      "title": "Isolate HMI load on J5",
      "body": "Disconnect power. Remove connector J5 from main control. Restore power.",
      "sourceExcerpt": "Disconnect power. Remove connector J5 from main control. Restore power.",
      "requiresInput": false,
      "defaultNextStepId": "j5_12vdc"
    },
    {
      "id": "j5_12vdc",
      "order": 7,
      "type": "measurement",
      "title": "+12 VDC at J5",
      "body": "DC volts: black J5-4 (Circuit Gnd), red J5-1 (+12 VDC). Do not short pins inside header.",
      "sourceExcerpt": "DC volts: black J5-4 (Circuit Gnd), red J5-1 (+12 VDC). Do not short pins inside header.",
      "measurementKnowledgeId": "whirlpoolWtw4100WasherAcu12Vdc",
      "testPoint": {
        "connector": "J5",
        "pins": "1 & 4",
        "label": "+12 VDC at J5",
        "pinDetails": [
          {
            "pin": "1",
            "signal": "+12 VDC",
            "wireColor": "RD",
            "wireColorConfidence": "verified"
          },
          {
            "pin": "3",
            "signal": "Communication",
            "wireColor": "YL",
            "wireColorConfidence": "verified"
          },
          {
            "pin": "4",
            "signal": "Circuit Gnd",
            "wireColor": "BK",
            "wireColorConfidence": "verified"
          }
        ]
      },
      "requiresInput": true,
      "branches": [
        {
          "id": "v12_ok",
          "label": "+12 VDC present",
          "when": {
