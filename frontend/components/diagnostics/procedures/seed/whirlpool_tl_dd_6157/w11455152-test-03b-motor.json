      "requiresInput": true,
      "branches": [
        {
          "id": "wash_fail",
          "label": "Unsuccessful",
          "when": {
            "kind": "checkpoint_no"
          },
          "nextStepId": "basket_free",
          "diagnosticEffects": [
            {
              "type": "suspect",
              "componentId": "drive_motor"
            }
          ]
        },
        {
          "id": "wash_ok",
          "label": "Motor runs",
          "when": {
            "kind": "checkpoint_yes"
