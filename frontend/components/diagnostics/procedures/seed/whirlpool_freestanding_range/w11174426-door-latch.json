              "componentId": "temp_sensor",
              "evidenceId": "confirm_temp_sensor_bad_temp_sensor_failed"
            }
          ]
        },
        {
          "id": "latch_crit",
          "label": "Critical out of range",
          "when": {
            "kind": "measurement_critical"
          },
          "nextStepId": "replace_latch",
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "temp_sensor",
              "evidenceId": "confirm_temp_sensor_bad_temp_sensor_failed"
            }
          ]
        },
        {
