      "id": "dsi_voltage",
      "order": 3,
      "type": "visual_check",
      "title": "DSI input voltage and spark gap",
      "body": "Verify 102\u2013132 VAC L1\u2013N at DSI. Recommended spark gap 0.125 in (3.18 mm). Visually verify spark on ignition.",
      "sourceExcerpt": "Verify 102\u2013132 VAC L1\u2013N at DSI. Recommended spark gap 0.125 in (3.18 mm). Visually verify spark on ignition.",
      "requiresInput": true,
      "branches": [
