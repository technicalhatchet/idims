          },
          "nextStepId": "replace_regulator",
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "gas_valve",
              "evidenceId": "confirm_gas_valve_ol_gas_valve_failed"
            }
          ]
        },
        {
          "id": "reg_crit",
          "label": "Critical out of range",
          "when": {
