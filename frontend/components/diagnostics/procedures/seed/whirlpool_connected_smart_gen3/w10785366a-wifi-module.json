        "pins": "1 & 6",
        "label": "WiFi module +5 VDC (J4-1 to J4-6)",
        "pinDetails": [
          {
            "pin": "1",
            "signal": "+5 VDC",
            "wireColor": "BK",
            "wireColorConfidence": "verified"
          },
          {
            "pin": "6",
            "signal": "GND",
            "wireColor": "Y",
            "wireColorConfidence": "verified"
