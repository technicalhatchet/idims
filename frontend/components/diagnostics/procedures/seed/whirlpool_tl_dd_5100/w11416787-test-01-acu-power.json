      "branches": [
        {
          "id": "j14_ui_fault",
          "label": "No \u2014 still not flashing",
          "when": {
            "kind": "checkpoint_no"
          },
          "nextStepId": "j14_12vdc",
          "diagnosticEffects": [
            {
              "type": "suspect",
              "componentId": "supply"
            }
          ]
