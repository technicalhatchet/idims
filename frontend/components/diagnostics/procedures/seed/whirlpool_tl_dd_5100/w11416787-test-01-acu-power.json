      "testPoint": {
        "connector": "J1",
        "pins": "1 & 2",
        "label": "Line voltage J1-1 to J1-2",
        "pinDetails": [
          {
            "pin": "1",
            "signal": "Neutral",
            "wireColor": "WH",
