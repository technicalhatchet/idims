      "order": 6,
      "type": "instruction",
      "title": "Isolate HMI load on J14",
      "body": "Disconnect power. Remove connector J14 from main control. Restore power and recheck Diagnostic LED.",
      "sourceExcerpt": "Disconnect power. Remove connector J14 from main control. Restore power and recheck Diagnostic LED.",
      "requiresInput": false,
      "defaultNextStepId": "led_after_j14"
    },
    {
      "id": "led_after_j14",
      "order": 7,
      "type": "visual_check",
      "title": "LED flashes with J14 removed?",
