      "order": 5,
      "type": "visual_check",
      "title": "Diagnostic LED state",
      "body": "Is the Diagnostic LED flashing, continuously ON, or OFF?",
      "sourceExcerpt": "Flashing: proceed to HMI Test. ON/OFF: continue ACU DC checks.",
      "requiresInput": true,
      "branches": [
        {
          "id": "led_flash",
          "label": "Flashing (+5 VDC, micro operating)",
          "when": {
            "kind": "checkpoint_yes"
          },
          "nextStepId": "acu_verified",
          "diagnosticEffects": [
            {
              "type": "eliminate",
              "componentId": "supply",
              "evidenceId": "eliminate_supply_critical_supply_ok"
            }
          ]
        },
        {
          "id": "led_on",
          "label": "ON steady (+5 VDC, micro failure)",
          "when": {
            "kind": "checkpoint_no"
          },
          "nextStepId": "replace_acu",
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "supply",
              "evidenceId": "confirm_supply_critical_supply_fault"
            }
          ]
        },
        {
          "id": "led_off",
          "label": "OFF (+5 VDC missing)",
          "when": {
            "kind": "checkpoint_no"
          },
          "nextStepId": "isolate_hmi",
          "diagnosticEffects": [
            {
              "type": "suspect",
              "componentId": "supply"
            }
          ]
        }
      ]
    },
