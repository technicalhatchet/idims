          },
          "nextStepId": "replace_heater",
          "terminal": true,
          "oemOutcome": "Replace heater assembly \u2014 open element.",
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "heating_element",
              "evidenceId": "confirm_heater_ol_heating_element_failed"
