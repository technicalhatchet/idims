          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "heater",
              "evidenceId": "confirm_heater_ol_heater_failed"
            }
          ]
        },
        {
          "id": "owi_ground_check_open",
          "label": "Open (OL)",
          "when": {
            "kind": "measurement_open"
          },
          "nextStepId": "replace_owi",
          "diagnosticEffects": [
            {
              "type": "confirm",
