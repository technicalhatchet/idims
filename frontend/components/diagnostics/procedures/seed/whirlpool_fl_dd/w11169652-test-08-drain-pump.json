  "steps": [
    {
      "id": "safety_power_off",
      "order": 1,
      "type": "safety",
      "title": "Disconnect power",
      "body": "Unplug the washer or disconnect power before servicing. Replace all parts and panels before operating.",
      "sourceExcerpt": "WARNING \u2014 Electrical Shock Hazard. Disconnect power before servicing. Failure to do so can result in death or electrical shock. Replace all parts and panels before operating.",
      "requiresInput": false,
      "defaultNextStepId": "check_obstructions"
    },
    {
      "id": "check_obstructions",
      "order": 2,
      "type": "visual_check",
      "title": "Obstructions cleared",
      "body": "Check the drain pump filter, drain hose, and usual blockage areas. Clean as needed before electrical testing.",
      "sourceExcerpt": "Check for obstructions in the usual areas. Clean and then perform step 2. Check the Drain Pump/Recirculation Pump filter for foreign objects.",
      "requiresInput": true,
      "branches": [
        {
          "id": "obstructions_cleared_yes",
          "label": "Areas checked and clear",
          "when": {
            "kind": "checkpoint_yes"
          },
          "nextStepId": "access_acu_j11"
        },
        {
          "id": "obstructions_cleared_no",
          "label": "Obstruction found or not yet cleared",
          "when": {
            "kind": "checkpoint_no"
          },
          "nextStepId": "clear_obstructions_first",
          "terminal": true,
          "oemOutcome": "Clear obstructions in the drain filter, hose, and pump area; then repeat TEST #8 from step 1.",
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "drain_pump",
              "evidenceId": "confirm_drain_pump_ol_drain_pump_failed"
            }
          ]
        }
      ]
    },
    {
      "id": "clear_obstructions_first",
      "order": 3,
      "type": "outcome",
      "title": "Clear obstructions first",
      "oemOutcome": "Remove foreign objects and verify drain path is clear; then repeat TEST #8.",
      "requiresInput": false
    },
    {
      "id": "access_acu_j11",
      "order": 4,
      "type": "instruction",
      "title": "Access ACU and verify J11",
      "body": "Remove the top panel to access the ACU. Perform TEST #1 ACU power check if needed. Verify connector J11 is fully seated in the ACU before resistance checks.",
      "sourceExcerpt": "Remove top panel to access machine electronics. Visually check that the J11 connector is inserted all the way into the ACU. If connector is not inserted properly, reconnect J11 and repeat Quick Service Cycle step 004.",
      "requiresInput": false,
      "defaultNextStepId": "j11_seated"
    },
    {
      "id": "j11_seated",
      "order": 5,
      "type": "visual_check",
      "title": "J11 fully seated",
      "body": "Is connector J11 fully inserted into the ACU?",
      "requiresInput": true,
      "branches": [
        {
          "id": "j11_seated_yes",
          "label": "J11 fully seated",
          "when": {
            "kind": "checkpoint_yes"
          },
          "nextStepId": "drain_j11_1_2"
        },
        {
          "id": "j11_seated_no",
          "label": "J11 loose or not seated",
          "when": {
            "kind": "checkpoint_no"
          },
          "nextStepId": "reseat_j11",
          "terminal": true,
          "oemOutcome": "Reconnect J11 at the ACU, reassemble, restore power, and repeat Quick Service Cycle step 004 (Drain Pump).",
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "drain_pump",
              "evidenceId": "confirm_drain_pump_ol_drain_pump_failed"
            }
          ]
        }
      ]
    },
    {
      "id": "drain_j11_1_2",
      "order": 6,
      "type": "measurement",
      "title": "Drain pump J11 pins 1 & 2",
      "body": "Remove connector J11 from the ACU. Measure resistance between J11-1 (Drain Pump) and J11-2 (LINE_MR) at room temperature.",
      "sourceExcerpt": "Remove connector J11 from the ACU. With an ohmmeter, measure the resistance across connector pins. Drain Pump \u2014 J11-1 to J11-2 \u2014 18.5\u201321.5 \u03a9.",
      "measurementKnowledgeId": "whirlpoolFlWasherDrainPumpOhms",
      "testPoint": {
        "connector": "J11",
        "pins": "1 & 2",
        "label": "Drain pump winding",
        "pinDetails": [
          {
            "pin": "1",
            "signal": "Drain pump",
            "wireColor": "W",
            "wireColorConfidence": "verified"
          },
          {
            "pin": "2",
            "signal": "LINE_MR",
            "wireColor": "BK",
            "wireColorConfidence": "inferred"
          }
        ]
      },
      "requiresInput": true,
      "branches": [
        {
          "id": "drain_j11_fail",
          "label": "Outside range",
          "when": {
            "kind": "measurement_warning"
          },
          "nextStepId": "inspect_pump_mechanical",
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "drain_pump",
              "evidenceId": "confirm_drain_pump_ol_drain_pump_failed"
            }
          ]
        },
        {
          "id": "drain_j11_open",
          "label": "Open circuit (OL)",
          "when": {
            "kind": "measurement_open"
          },
          "nextStepId": "inspect_pump_mechanical",
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "drain_pump",
              "evidenceId": "confirm_drain_pump_ol_drain_pump_failed"
            }
          ]
        },
        {
          "id": "drain_j11_critical",
          "label": "Critical out of range",
          "when": {
            "kind": "measurement_critical"
          },
          "nextStepId": "inspect_pump_mechanical",
          "diagnosticEffects": [
            {
              "type": "confirm",
              "componentId": "drain_pump",
              "evidenceId": "confirm_drain_pump_ol_drain_pump_failed"
            }
          ]
        },
        {
          "id": "drain_j11_pass",
          "label": "18.5\u201321.5 \u03a9",
          "when": {
            "kind": "measurement_normal"
          },
          "nextStepId": "recirc_j11_3_4",
          "diagnosticEffects": [
            {
              "type": "eliminate",
              "componentId": "drain_pump",
              "evidenceId": "eliminate_drain_pump_ol_drain_pump_ok"
            }
          ]
        }
