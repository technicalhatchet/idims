          {
            "pin": "1",
            "signal": "LINE input",
            "wireColor": "BK",
            "wireColorConfidence": "verified"
          },
          {
            "pin": "2",
            "signal": "Neutral input",
            "wireColor": "WT",
            "wireColorConfidence": "verified"
          }
