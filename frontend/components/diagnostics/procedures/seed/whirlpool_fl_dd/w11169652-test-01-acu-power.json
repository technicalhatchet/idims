  "steps": [
    {
      "id": "safety_power_off",
      "order": 1,
      "type": "safety",
      "title": "Disconnect power",
      "body": "Unplug the washer or disconnect power before servicing. Replace all parts and panels before operating.",
      "sourceExcerpt": "WARNING \u2014 Electrical Shock Hazard. Disconnect power before servicing.",
      "requiresInput": false,
      "defaultNextStepId": "access_electronics"
    },
    {
      "id": "access_electronics",
      "order": 2,
      "type": "instruction",
      "title": "Access machine electronics",
      "body": "Remove the top panel. Visually verify all RFI filter and ACU connections are fully seated.",
      "sourceExcerpt": "Remove the top panel. Visually verify all RFI filter and ACU connections are fully seated.",
      "requiresInput": false,
      "defaultNextStepId": "visual_if_acu"
    },
    {
      "id": "visual_if_acu",
      "order": 3,
      "type": "visual_check",
      "title": "RFI filter and ACU connections OK",
      "body": "Are all interference filter and ACU harness connections secure and fully inserted?",
      "sourceExcerpt": "Are all interference filter and ACU harness connections secure and fully inserted?",
      "requiresInput": true,
      "branches": [
        {
          "id": "vis_ok",
          "label": "Connections OK",
          "when": {
            "kind": "checkpoint_yes"
          },
          "nextStepId": "restore_power_line"
        },
        {
          "id": "vis_bad",
          "label": "Loose or damaged connection",
          "when": {
            "kind": "checkpoint_no"
          },
          "nextStepId": "repair_connections",
          "terminal": true,
          "oemOutcome": "Repair or reconnect loose harness/connector terminals, then repeat TEST #1."
        }
      ]
    },
    {
      "id": "restore_power_line",
      "order": 4,
      "type": "instruction",
      "title": "Restore power for voltage checks",
      "body": "Plug in or reconnect power for live voltage measurements only. Use needle probes on connectors.",
      "sourceExcerpt": "Plug in or reconnect power for live voltage measurements only. Use needle probes on connectors.",
      "requiresInput": false,
      "defaultNextStepId": "line_if_input"
    },
    {
      "id": "line_if_input",
      "order": 5,
      "type": "measurement",
      "title": "Line voltage at RFI filter input",
      "body": "With AC voltmeter, measure line voltage at the interference filter input (power cord side).",
      "sourceExcerpt": "With AC voltmeter, measure line voltage at the interference filter input (power cord side).",
      "measurementKnowledgeId": "supplyVoltage120",
      "testPoint": {
        "connector": "RFI",
        "pins": "Line in",
        "label": "Line voltage at RFI filter input",
        "pinDetails": [
          {
            "pin": "Line",
            "signal": "Filter input \u2014 cord line",
            "wireColor": "BK",
            "wireColorConfidence": "verified"
          },
          {
            "pin": "Neutral",
            "signal": "Filter input \u2014 cord neutral",
            "wireColor": "WT",
            "wireColorConfidence": "verified"
          }
        ]
      },
      "requiresInput": true,
      "branches": [
        {
          "id": "line_in_ok",
          "label": "Line voltage present",
          "when": {
            "kind": "measurement_normal"
          },
          "nextStepId": "line_if_output"
        },
        {
          "id": "line_in_bad",
          "label": "No line voltage",
          "when": {
            "kind": "measurement_critical"
          },
          "nextStepId": "replace_cord",
          "terminal": true,
          "oemOutcome": "Verify outlet and cord continuity; replace power cord if cord fails continuity check."
        },
        {
          "id": "line_in_warn",
          "label": "Low/out of range voltage",
          "when": {
            "kind": "measurement_warning"
          },
          "nextStepId": "replace_cord",
          "terminal": true,
          "oemOutcome": "Correct supply voltage issue or replace power cord before further ACU testing."
        }
      ]
    },
    {
      "id": "line_if_output",
      "order": 6,
      "type": "measurement",
      "title": "Line voltage at RFI filter output",
      "body": "Measure AC line voltage at the interference filter output toward the ACU.",
      "sourceExcerpt": "Measure AC line voltage at the interference filter output toward the ACU.",
      "measurementKnowledgeId": "supplyVoltage120",
      "testPoint": {
        "connector": "RFI",
        "pins": "Line out",
        "label": "Line voltage at RFI filter output",
        "pinDetails": [
          {
            "pin": "Line",
            "signal": "Filter input \u2014 cord line",
            "wireColor": "BK",
            "wireColorConfidence": "verified"
          },
          {
            "pin": "Neutral",
            "signal": "Filter input \u2014 cord neutral",
            "wireColor": "WT",
            "wireColorConfidence": "verified"
          }
        ]
